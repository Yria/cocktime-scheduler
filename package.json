{
	"name": "cocktime-scheduler",
	"private": true,
	"version": "0.0.0",
	"homepage": "https://Yria.github.io/cocktime-scheduler",
	"type": "module",
	"packageManager": "pnpm@11.8.0",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:board:browser": "playwright test",
		"test:accounting:browser": "playwright test e2e/accounting.spec.ts",
		"preview": "vite preview",
		"deploy": "pnpm run build && gh-pages -d dist",
		"photos": "scripts/.venv/bin/python -u scripts/fetch_photos.py",
		"photos:dry": "scripts/.venv/bin/python -u scripts/fetch_photos.py --dry-run"
	},
	"dependencies": {
		"@pixi/react": "8.0.5",
		"@react-aria/overlays": "^3.32.1",
		"@supabase/supabase-js": "^2.97.0",
		"@tanstack/react-virtual": "^3.14.3",
		"es-hangul": "^2.3.8",
		"immer": "^11.1.4",
		"lucide-react": "^1.0.1",
		"pixi.js": "8.20.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^7.13.0",
		"remark-gfm": "^4.0.1",
		"uuid": "^14.0.2",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@electric-sql/pglite": "^0.5.8",
		"@eslint/js": "^9.39.1",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/vite": "^4.2.0",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"gh-pages": "^6.3.0",
		"globals": "^16.5.0",
		"tailwindcss": "^4.2.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.48.0",
		"vite": "^7.3.1",
		"vitest": "^4.0.18"
	}
}
